# --- App ---
APP_NAME=D.E.L.P.H.I
APP_ENV=development          # development | production | testing
DEBUG=true
LOG_LEVEL=INFO

# --- Database ---
# SQLite for dev. Swap to a Postgres URL later with zero code changes,
# e.g. postgresql+psycopg2://user:password@localhost:5432/fpl_oracle
DATABASE_URL=sqlite:///./data/fpl_oracle.db

# --- FPL API ---
FPL_BASE_URL=https://fantasy.premierleague.com/api
FPL_REQUEST_TIMEOUT_SECONDS=15
FPL_MAX_RETRIES=3

# --- My squad ---
# Your FPL team/entry ID (visible in the URL when viewing your team on the FPL site)
FPL_TEAM_ID=1744086

# --- Scheduler ---
ENABLE_SCHEDULER=true
WEEKLY_UPDATE_CRON=0 8 * * 2   # Tuesdays 08:00, adjust to taste

# --- Paths ---
DATA_DIR=./data
LOG_DIR=./logs
# --- Telegram ---
TELEGRAM_BOT_TOKEN=8966977339:AAFiHqttmUAy1nFOCWyUDB4hdEAiKQydJfE
TELEGRAM_CHAT_ID=7069805097

PIPELINE_SECRET=
